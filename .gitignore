# ============ 运行数据：绝对不要提交 ============
# 里面有真实宠物档案、日记照片、记账记录，以及个人隐私信息
data/
!data/.gitkeep

# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ============ 日志 / 备份 / 临时文件 ============
*.log
*.out
*.bak
*.bak_*
*~
*.tmp
*.swp

# 自检与迁移留下的临时库
*.db
*.db-journal
*.db-wal
!.gitkeep

# ============ 操作系统 ============
Thumbs.db
Desktop.ini
.DS_Store

# ============ 编辑器 ============
.idea/
.vscode/
*.code-workspace
